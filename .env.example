# Application
APP_NAME=Intelligent Media Processing Pipeline
APP_ENV=development
LOG_LEVEL=INFO

# Database (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg2://app:app@localhost:5432/media_pipeline

# Redis / RQ
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=image_jobs

# Local image storage (relative to project root unless absolute)
STORAGE_PATH=./storage/original

# Upload limits
MAX_UPLOAD_SIZE_MB=10

# Analyzer thresholds (heuristic, not scientifically calibrated)
# Laplacian variance below this value is treated as possibly blurry.
# Typical guidance: <20 very blurry, 20-100 blurry, >100 often acceptable.
BLUR_THRESHOLD=100.0

# Mean grayscale brightness (0-255). Values below this are treated as low-light.
BRIGHTNESS_THRESHOLD=50.0

# Perceptual hash Hamming distance. 0 = exact pHash match.
# Distances <= this value are treated as near-duplicates for this take-home.
DUPLICATE_HASH_DISTANCE=5

# Worker
JOB_TIMEOUT_SECONDS=300
JOB_RETRY_MAX=2

# CORS — comma-separated browser origins allowed to call the API
FRONTEND_ORIGINS=https://intelligent-media-processing-pipeline-oido.onrender.com,http://localhost:5173,http://localhost:5174
